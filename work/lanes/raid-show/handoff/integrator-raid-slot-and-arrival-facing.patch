+
+it('keeps the newest raid as the one current raid, so a raider who follows the link later finds its column', () => {
+  const projection = new PublicProjection({ homes: [], cursor: 0, presence: null, sequence: 0 });
+  const raid = (seq: number, id: string) => fact(seq, { kind: 'raid', key: `raid.${id}`, raidKey: `raid.${id}` });
+  projection.adopt([row(1, raid(1, 'a'), true)]);
+  expect(facts(projection)).toEqual([1]);
+  projection.adopt([row(2, raid(2, 'b'), true)]);
+  expect(facts(projection)).toEqual([2]);
+  // A late, superseded report of the older raid is published non-current and leaves the newer one in place.
+  projection.adopt([row(3, raid(3, 'a'), false)]);
+  expect(facts(projection)).toEqual([2]);
+});
