+++ b/packages/audio/src/play-mix.ts
@@ -0,0 +1,35 @@
+import type { CueFamily } from './families';
+import { AUDIO_GROUPS, type AudioGroup, type AudioGroupVolumes } from './types';
+
+/**
+ * The settings ledger's volume groups (world, voice, interface) under the kingdom's master. Each group is a fader in
+ * [0, 1] heard as volume², the same law as the master, so "half" sounds like half on every slider. A change ramps
+ * over the master's 30 ms on every voice still ringing in that group and on the group's hosted layers, so a slider
+ * drag never clicks. With every group at 1 (the default) nothing in the mix changes.
+ */
+
+export const DEFAULT_GROUPS: Readonly<AudioGroupVolumes> = Object.freeze({ world: 1, voice: 1, interface: 1 });
+
+/** The gain a group volume becomes. */
+export function groupLevel(volume: number): number {
+  return volume * volume;
+}
+
+/** Merges a partial group patch into the current groups. Unknown groups throw; non-finite volumes throw; the rest clamp. */
+export function normalizeGroups(current: Readonly<AudioGroupVolumes>, next: Readonly<Partial<AudioGroupVolumes>> | undefined): Readonly<AudioGroupVolumes> {
+  const result: AudioGroupVolumes = { ...current };
+  if (next === undefined) return Object.freeze(result);
+  if (!next || typeof next !== 'object') throw new TypeError('kingdom audio: groups must be an object of volumes');
+  for (const [group, volume] of Object.entries(next)) {
+    if (!AUDIO_GROUPS.includes(group as AudioGroup)) throw new TypeError(`kingdom audio: unknown volume group ${group}`);
+    if (volume === undefined) continue;
+    if (typeof volume !== 'number' || !Number.isFinite(volume)) throw new RangeError(`kingdom audio: the ${group} volume must be a finite number`);
+    result[group as AudioGroup] = Math.min(1, Math.max(0, volume));
+  }
+  return Object.freeze(result);
+}
+
+/** Which group a family follows: its own, else `interface` for the carved controls and `world` for everything else. */
+export function familyGroup(family: Pick<CueFamily, 'group' | 'tier'>): AudioGroup {
+  return family.group ?? (family.tier === 'control' ? 'interface' : 'world');
+}
