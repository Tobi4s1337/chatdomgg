+/** Conservative XZ coverage of a placed kit; future fitted growth/scene occupancy is separate. */
+function placementBounds(p: GrandKitPlacement): readonly [number, number, number, number] {
+  let minX = Infinity, minZ = Infinity, maxX = -Infinity, maxZ = -Infinity;
+  const turns = ((p.turns % 4) + 4) % 4;
+  for (const box of p.piece.boxes) {
+    let x = box.min[0], z = box.min[2], sx = box.size[0], sz = box.size[2];
+    for (let t = 0; t < turns; t++) { [x,z] = [-z-sz,x]; [sx,sz] = [sz,sx]; }
+    minX = Math.min(minX, x + p.at[0]); minZ = Math.min(minZ, z + p.at[2]);
+    maxX = Math.max(maxX, x + sx + p.at[0]); maxZ = Math.max(maxZ, z + sz + p.at[2]);
+  }
+  return [minX,minZ,maxX,maxZ];
 }
 
