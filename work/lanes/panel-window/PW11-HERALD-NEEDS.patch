diff -ruN a/apps/herald/src/privacy/commands.ts b/apps/herald/src/privacy/commands.ts
--- a/apps/herald/src/privacy/commands.ts
+++ b/apps/herald/src/privacy/commands.ts
@@ -0,0 +1,41 @@
+import type { KingdomId, PersonId } from '@chatdom/shared';
+
+/** The realm's Herald-only door for a chatter's own privacy (`apps/realm/src/ingress/panel/chat.ts`). */
+export const REALM_CHAT_PRIVACY_PATH = '/internal/realm/chat/privacy';
+export type PrivacyCommand = 'quiet' | 'quiet-off' | 'forget';
+export interface PrivacyRequest { readonly kingdomId: KingdomId; readonly personId: PersonId; readonly messageId: string; readonly command: PrivacyCommand }
+export type PrivacyCommandSink = (input: PrivacyRequest) => Promise<void>;
+
+/** Exact commands only; anything else is ordinary chat. Called after ChatIngest has checked the event, the author and the coverage. */
+export function privacyCommand(raw: unknown): PrivacyCommand | null {
+  const text = (raw as { message?: { text?: unknown } } | null)?.message?.text;
+  if (typeof text !== 'string' || text.length > 40) return null;
+  const words = text.trim().toLowerCase().split(/\s+/).join(' ');
+  return words === '!chatdom quiet' ? 'quiet' : words === '!chatdom quiet off' ? 'quiet-off' : words === '!chatdom forget' ? 'forget' : null;
+}
+
+/**
+ * Posts the verified chatter's own command and hands the realm's reply line to the chat sender. One request per
+ * message, never retried: forget is safe to repeat, so the person can simply send it again. `reply` posts without an
+ * @-mention, and in development only to the team's own channel.
+ */
+export function createPrivacyClient(options: { readonly realmUrl: string; readonly secret: string; readonly reply: (input: PrivacyRequest, line: string) => Promise<void> }): PrivacyCommandSink {
+  const endpoint = new URL(REALM_CHAT_PRIVACY_PATH, options.realmUrl);
+  if (endpoint.protocol !== 'https:' && !(endpoint.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(endpoint.hostname))) throw new Error('The privacy door needs HTTPS or loopback.');
+  let inFlight = 0;
+  return async input => {
+    if (inFlight >= 32) return;
+    inFlight++;
+    try {
+      let line = 'That did not reach the kingdom just now. It is safe to send it again.';
+      try {
+        const response = await fetch(endpoint, { method: 'POST', redirect: 'error', signal: AbortSignal.timeout(8_000),
+          headers: { Authorization: `Bearer ${options.secret}`, 'Content-Type': 'application/json' },
+          body: JSON.stringify({ version: 1, kingdomId: input.kingdomId, personId: input.personId, command: input.command }) });
+        const body = await response.json() as { reply?: unknown };
+        if (response.ok && typeof body.reply === 'string' && body.reply.length > 0 && body.reply.length <= 300) line = body.reply;
+      } catch { /* The fallback line says to send it again. */ }
+      await options.reply(input, line);
+    } finally { inFlight--; }
+  };
+}
