+import { randomBytes } from 'node:crypto';
+import { z } from 'zod';
+import { EpochMsSchema, KingdomIdSchema, PersonIdSchema, TokenSchema } from '@chatdom/shared';
+import type { uWebSocketsTransport } from '@colyseus/uwebsockets-transport';
+import type { RealmDatabase } from '../persistence';
+import { IngressGate, type IngressCredentials } from './gate';
+import { forgetPerson, setPersonQuiet, type RealmForgetAuthority } from './panel';
+const Request = z.strictObject({ kingdomId: KingdomIdSchema, personId: PersonIdSchema, messageId: TokenSchema, observedAt: EpochMsSchema,
+  command: z.discriminatedUnion('action', [z.strictObject({ action: z.literal('quiet'), quiet: z.boolean() }),
+    z.strictObject({ action: z.literal('prepare') }), z.strictObject({ action: z.literal('confirm'), token: z.string().regex(/^[a-f0-9]{32}$/) })]) });
+/** A restart forgets challenges and therefore requires a fresh confirmation; no raw chat or names are stored. */
+export function mountChatPrivacy(app: uWebSocketsTransport['app'], options: {
+  db: Pick<RealmDatabase, 'query'>; origin: 'live' | 'simulated'; credentials: IngressCredentials; authority?: RealmForgetAuthority;
+}) {
+  const gate = new IngressGate(options.credentials, options.origin);
+  const pending = new Map<string, { token: string; messageId: string; at: number; until: number }>();
+  app.post('/internal/realm/chat-privacy', (res, req) => {
+    let aborted = false, done = false, size = 0;
+    const chunks: Buffer[] = [];
+    res.onAborted(() => { aborted = true; });
+    const reply = (status: 200 | 400 | 401 | 503, line: string) => {
+      if (aborted || done) return; done = true;
+      res.cork(() => res.writeStatus({ 200: '200 OK', 400: '400 Bad Request', 401: '401 Unauthorized', 503: '503 Service Unavailable' }[status])
+        .writeHeader('Content-Type', 'application/json').writeHeader('Cache-Control', 'no-store').end(JSON.stringify({ line })));
+    };
+    if (gate.authenticate(req.getHeader('authorization')) !== 'herald') return reply(401, 'Unknown Herald service.');
+    if (!/^application\/json\b/i.test(req.getHeader('content-type'))) return reply(400, 'Send JSON.');
+    res.onData((chunk, last) => {
+      if (done) return;
+      size += chunk.byteLength; if (size > 4096) return reply(400, 'The request is too large.');
+      chunks.push(Buffer.from(chunk.slice(0))); if (!last) return;
+      void (async () => {
+        const input = Request.parse(JSON.parse(Buffer.concat(chunks).toString('utf8'))), now = Date.now();
+        if (input.observedAt > now + 5000 || now - input.observedAt >= 90000) return reply(400, 'That command has expired.');
+        const key = `${input.kingdomId}:${input.personId}`;
+        for (const [id, value] of pending) if (value.until <= now) pending.delete(id);
+        if (input.command.action === 'quiet') {
+          await setPersonQuiet(options.db, options.origin, input.personId, input.command.quiet);
+          return reply(200, 'Preference saved. Stream hiding is still being connected.');
+        }
+        if (!options.authority) return reply(503, 'Forget is unavailable. Nothing was erased.');
+        if (input.command.action === 'prepare') {
+          if (pending.size >= 1024 && !pending.has(key)) return reply(503, 'Please try again shortly. Nothing was erased.');
+          const token = randomBytes(16).toString('hex');
+          pending.set(key, { token, messageId: input.messageId, at: input.observedAt, until: now + 120000 });
+          return reply(200, `Erase Twitch-derived history across all kingdoms? Homes and earned things stay. Within two minutes type !chatdom forget confirm ${token}`);
+        }
+        const challenge = pending.get(key);
+        if (!challenge || challenge.token !== input.command.token || challenge.messageId === input.messageId || input.observedAt <= challenge.at)
+          return reply(400, 'Start with !chatdom forget, then confirm the new code. Nothing was erased.');
+        pending.delete(key); // One caller consumes the challenge before any asynchronous erasure work.
+        const answer = await forgetPerson(options.authority, { personId: input.personId, requestedFromKingdomId: input.kingdomId,
+          origin: options.origin, requestId: `chat-forget:${challenge.token}` });
+        if (answer.status === 'unavailable') return reply(503, 'Forget is unavailable. Nothing was erased.');
+        return reply(200, answer.status === 'pending' ? 'Erasure is pending. It is not finished.' : 'Twitch-derived history was erased. Your homes and earned things remain.');
+      })().catch(() => reply(503, 'Privacy could not be confirmed. Open You in the Chatdom panel.'));
+    });
+  });
+}
