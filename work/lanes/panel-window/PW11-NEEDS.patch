+import type { RealmPublicMessage } from '@chatdom/shared/realm';
+import type { Credit, TwitchMomentFact } from '@chatdom/shared/twitch-moments';
+import type { DurableKingdom, RealmDatabase } from '../persistence';
+export interface WatchNames { key: string; project(message: RealmPublicMessage): RealmPublicMessage }
+/** Current private ownership resolves slots. Neither person IDs nor the quiet registry cross the watch wire. */
+export async function readWatchNames(db: Pick<RealmDatabase, 'query'>, kingdom: DurableKingdom): Promise<WatchNames> {
+  const homes = [...Object.values(kingdom.privateState.homes), ...(kingdom.privateState.castle ? [kingdom.privateState.castle] : [])];
+  const rows = await db.query<{ person_id: string }>('SELECT person_id FROM realm_panel_privacy WHERE origin = $1 AND quiet = true AND person_id = ANY($2::text[])',
+    [kingdom.origin, homes.map(home => home.ownerId)]);
+  const people = new Set(rows.rows.map(row => row.person_id));
+  const slots = new Set(homes.filter(home => people.has(home.ownerId)).map(home => home.slot));
+  const credit = (value: Credit): Credit => value && value.slot !== null && !slots.has(value.slot) ? value : null;
+  const fact = (value: TwitchMomentFact): TwitchMomentFact => {
+    const body = value.body;
+    if ('credit' in body) return { ...value, body: { ...body, credit: credit(body.credit) } };
+    if (body.kind === 'gifts') return { ...value, body: { ...body, giver: credit(body.giver), forwardedFrom: credit(body.forwardedFrom), recipients: body.recipients.map(item => ({ ...item, credit: credit(item.credit) })) } };
+    if (body.kind === 'hype') return { ...value, body: { ...body, contributors: body.contributors.map(credit) } };
+    if (body.kind === 'charity') return { ...value, body: { ...body, donation: body.donation && { ...body.donation, credit: credit(body.donation.credit) } } };
+    return value;
+  };
+  return { key: [...slots].sort((a, b) => a - b).join(','), project: message => {
+    if (message.type === 'presence') return { ...message, frame: { ...message.frame,
+      windows: message.frame.windows.map(window => slots.has(window.slot) ? { ...window, publicName: null } : window) } };
+    if (message.type === 'moment') return { ...message, fact: fact(message.fact) };
+    if (message.type === 'moments.current') return { ...message, facts: message.facts.map(fact) };
+    return message;
+  } };
+}
