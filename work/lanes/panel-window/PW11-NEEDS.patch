+import type { KingdomId, PersonId } from '@chatdom/shared';
+
+export type PrivacyCommand = { action: 'quiet'; quiet: boolean } | { action: 'prepare' } | { action: 'confirm'; token: string };
+export interface PrivacyRequest { kingdomId: KingdomId; personId: PersonId; messageId: string; observedAt: number; command: PrivacyCommand }
+export type PrivacyCommandSink = (input: PrivacyRequest) => Promise<void>;
+/** Called only after ChatIngest authenticates EventSub, checks channel/author IDs, age and deletion. */
+export function privacyCommand(raw: unknown): PrivacyCommand | null {
+  const text = (raw as { message?: { text?: unknown } } | null)?.message?.text;
+  if (typeof text !== 'string' || text.length > 160) return null;
+  if (/^!chatdom quiet$/i.test(text.trim())) return { action: 'quiet', quiet: true };
+  if (/^!chatdom quiet off$/i.test(text.trim())) return { action: 'quiet', quiet: false };
+  if (/^!chatdom forget$/i.test(text.trim())) return { action: 'prepare' };
+  const confirm = /^!chatdom forget confirm ([a-f0-9]{32})$/i.exec(text.trim());
+  return confirm ? { action: 'confirm', token: confirm[1]!.toLowerCase() } : null;
+}
+/** No automatic retry of a destructive confirmation. Reply is the owner's real, authorized chat sender. */
+export function createPrivacyClient(options: { url: string; secret: string; reply: (input: PrivacyRequest, line: string) => Promise<void> }): PrivacyCommandSink {
+  const endpoint = new URL('/internal/realm/chat-privacy', options.url);
+  if (endpoint.protocol !== 'https:' && !(endpoint.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(endpoint.hostname))) throw new Error('Privacy transport needs HTTPS or loopback.');
+  let inFlight = 0;
+  return async input => {
+    if (inFlight >= 32) return;
+    inFlight++;
+    try {
+    let line = 'Privacy could not be confirmed. Open You in the Chatdom panel.';
+    try {
+      const response = await fetch(endpoint, { method: 'POST', redirect: 'error', signal: AbortSignal.timeout(8_000),
+        headers: { Authorization: `Bearer ${options.secret}`, 'Content-Type': 'application/json' }, body: JSON.stringify(input) });
+      const body = await response.json() as { line?: unknown };
+      if (typeof body.line === 'string' && body.line.length > 0 && body.line.length <= 500) line = body.line;
+    } catch { /* A lost reply is not proof that nothing changed. */ }
+    await options.reply(input, line);
+    } finally { inFlight--; }
+  };
+}
