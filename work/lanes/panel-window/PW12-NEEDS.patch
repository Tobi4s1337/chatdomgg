+import { z } from 'zod';
+import { KingdomIdSchema, EpochMsSchema, TokenSchema } from '@chatdom/shared';
+import type { PanelGiftFact } from '../../../../../packages/shared/src/panel';
+
+const Integer = z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER);
+const Fact = z.strictObject({
+  version: z.literal(1), type: z.literal('panel.gift'), id: TokenSchema,
+  kingdomId: KingdomIdSchema, giftId: z.string().regex(/^[a-z0-9]{1,64}$/),
+  sequence: Integer.min(1), effectVersion: Integer.min(1), committedAt: EpochMsSchema, endsAt: EpochMsSchema,
+  credit: z.strictObject({ name: z.string().min(1).max(64), slot: Integer.nullable() }).nullable(),
+  target: z.strictObject({ plotId: TokenSchema, slot: Integer }).nullable(), line: z.string().min(1).max(160),
+}).refine(fact => fact.endsAt >= fact.committedAt && fact.endsAt - fact.committedAt <= 86_400_000);
+const Page = z.strictObject({ version: z.literal(1), throughSequence: Integer, facts: z.array(Fact).max(64) });
+export interface PanelGiftPage { readonly version: 1; readonly throughSequence: number; readonly facts: readonly PanelGiftFact[] }
+
+/** A separate gift sequence: never reinterpret this as TwitchMomentFact or a domain sequence. */
+export function readPanelGiftPage(raw: unknown, kingdomId: string): PanelGiftPage {
+  const page = Page.parse(raw);
+  let previous = 0;
+  for (const fact of page.facts) {
+    if (fact.kingdomId !== kingdomId || fact.sequence <= previous || fact.sequence > page.throughSequence) throw new Error('Invalid gift page.');
+    previous = fact.sequence;
+  }
+  return page;
+}
