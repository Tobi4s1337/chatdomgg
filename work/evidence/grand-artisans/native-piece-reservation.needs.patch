+/**
+ * Before packing: discard a whole placement if any one of its authored boxes touches a protected
+ * half-open XZ region. This operates on render proposals only and grants no physical authority.
+ * Already-packed structures do not retain the provenance required by this function.
+ */
+export function retainUnreservedPlacements(
+  placements: readonly GrandKitPlacement[], reserve: KingdomReserve,
+): { placements: GrandKitPlacement[]; removed: number } {
+  if (![reserve.x0, reserve.z0, reserve.x1, reserve.z1].every(Number.isSafeInteger)
+    || reserve.x0 >= reserve.x1 || reserve.z0 >= reserve.z1) throw new RangeError('Invalid protected land rectangle');
+  const kept: GrandKitPlacement[] = [];
+  for (const placement of placements) {
+    let reject = !Number.isSafeInteger(placement.turns) || placement.at.length !== 3
+      || !placement.at.every(Number.isSafeInteger) || !placement.piece.boxes.length;
+    if (!reject) for (const box of placement.piece.boxes) {
+      if (box.min.length !== 3 || box.size.length !== 3 || !box.min.every(Number.isSafeInteger)
+        || !box.size.every(n => Number.isSafeInteger(n) && n > 0)) { reject = true; break; }
+      let [x, , z] = box.min, [sx, , sz] = box.size;
+      for (let n = 0; n < ((placement.turns % 4) + 4) % 4; n++) [x, z, sx, sz] = [-z - sz, x, sz, sx];
+      x += placement.at[0]; z += placement.at[2];
+      if (![x, z, x + sx, z + sz, box.min[1] + placement.at[1], box.min[1] + placement.at[1] + box.size[1]].every(Number.isSafeInteger)
+        || (x < reserve.x1 && x + sx > reserve.x0 && z < reserve.z1 && z + sz > reserve.z0)) { reject = true; break; }
+    }
+    if (!reject) kept.push(placement);
+  }
+  return { placements: kept, removed: placements.length - kept.length };
