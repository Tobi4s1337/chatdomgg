+import { describe, expect, it } from 'vitest';
+import { createWindmill } from '../artisans/fields';
+import { placeBox } from '../artisans/adoption';
+import { retainUnreservedPlacements } from './sites';
+import type { GrandKitPlacement } from '../types';
+
+describe('whole-placement reserve', () => {
+  it.each([0,1,2,3])('rejects a whole authored windmill at turn %s', turns => {
+    const kit=createWindmill('reserve'), occupied:GrandKitPlacement={piece:kit,at:[-40,20,40],turns};
+    const other:GrandKitPlacement={piece:kit,at:[150,20,150],turns};
+    const box=placeBox(kit.boxes[0]!,occupied.at,turns);
+    const reserve={x0:box.min[0],z0:box.min[2],x1:box.min[0]+1,z1:box.min[2]+1};
+    const result=retainUnreservedPlacements([occupied,other],reserve);
+    expect(result.removed).toBe(1);expect(result.placements).toEqual([other]);expect(result.placements[0]).toBe(other);
+  });
+  it('retains exact half-open boundary contact and removes an actual overlap', () => {
+    const piece={id:'two-box',anchors:{},boxes:[{min:[0,0,0] as const,size:[2,1,2] as const,colour:'#000000'},
+      {min:[8,0,0] as const,size:[2,1,2] as const,colour:'#ffffff'}]};
+    const p:GrandKitPlacement={piece,at:[0,0,0],turns:0};
+    expect(retainUnreservedPlacements([p],{x0:2,z0:0,x1:8,z1:2}).placements).toEqual([p]);
+    expect(retainUnreservedPlacements([p],{x0:8,z0:0,x1:9,z1:1}).placements).toEqual([]);
+  });
+  it('fails closed for invalid placement or reserve coordinates', () => {
+    const p:GrandKitPlacement={piece:createWindmill('reserve'),at:[Number.MAX_SAFE_INTEGER,0,0],turns:0};
+    expect(retainUnreservedPlacements([p],{x0:0,z0:0,x1:1,z1:1}).placements).toEqual([]);
+    expect(()=>retainUnreservedPlacements([],{x0:1,z0:0,x1:1,z1:1})).toThrow(RangeError);
+  });
+});
