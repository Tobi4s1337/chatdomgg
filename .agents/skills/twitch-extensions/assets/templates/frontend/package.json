{
  "name": "twitch-extension-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "zip": "npm run build && cd dist && rm -f ../extension.zip && zip -r ../extension.zip . -x '*.map'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
